{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Private cloud save document for an authenticated player in Life in Accra.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Player display name.",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "object",
          "description": "Structured game state map containing stats, career, location, friends, and log."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when save was last updated."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "state",
        "updatedAt"
      ]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public resident profile summary in Accra.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the resident.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Resident display name.",
          "minLength": 1,
          "maxLength": 64
        },
        "day": {
          "type": "integer",
          "description": "Current day reached by resident."
        },
        "career": {
          "type": "string",
          "description": "Resident current career.",
          "enum": ["unemployed", "trader", "developer", "teacher", "musician", "driver", "student"],
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "day",
        "career",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/players/{userId}": {
      "schema": "Player",
      "description": "Private cloud game saves keyed by Firebase Auth UID."
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Public resident profiles keyed by Firebase Auth UID."
    }
  }
}
